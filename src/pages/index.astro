---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import WhyUs from '../components/WhyUs.astro';
import Equipment from '../components/Equipment.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import ServicesSlider from '../components/ServicesSlider.astro';
import FAQ from '../components/FAQ.astro'; 
---

<BaseLayout
  title="ДКБ-Пол — Полусухая стяжка пола в Гомеле | Доступно, Качественно, Быстро"
  description="Профессиональная полусухая стяжка пола в Гомеле и области. Цены от 16 BYN/м². Сроки от 1 дня. Гарантия качества. ☎ +375 29 630-00-80"
>
  <SchemaOrg slot="head" />
  <Header />
  <main>
    <Hero />
    <ServicesSlider/>
    <WhyUs />
    <Equipment />
    <Testimonials />
    <ContactForm />
    <FAQ/>
  </main>
  <Footer />
</BaseLayout>