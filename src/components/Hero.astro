---
const stats = [
  { value: '16', unit: 'BYN/м²', label: 'Цены от' },
  { value: '1', unit: 'день', label: 'Сроки от' },
  { value: '96', unit: '%', label: 'Положительных отзывов' },
];
---

<section class="hero" id="hero">
  <div class="container hero__inner">
    <div class="hero__content">
      <h1 class="hero__title">
        Полусухая стяжка пола<br />
        <span>в Гомеле и области</span>
      </h1>
      <p class="hero__subtitle">
        Честный сервис — вы можете присутствовать при выполнении работ.
        Гарантия качества. Приём заявок круглосуточно.
      </p>
      <div class="hero__actions">
        <a href="#contact" class="btn btn-primary">
          Рассчитать стоимость
        </a>
        <a href="tel:+375296300080" class="btn btn-outline">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.36 11.36 0 003.58.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.36 11.36 0 00.57 3.58 1 1 0 01-.24 1.01l-2.2 2.2z"/>
          </svg>
          Позвонить
        </a>
      </div>
    </div>

    <div class="hero__stats">
      {stats.map(s => (
        <div class="hero__stat">
          <span class="hero__stat-value">{s.value}<small>{s.unit}</small></span>
          <span class="hero__stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* .hero {
    background: linear-gradient(135deg, #1B5E20 0%, #2E7D32 50%, #43A047 100%);
    color: #fff;
    padding: 100px 0 80px;
  } */

  .hero {
  position: relative;
  color: #fff;
  padding: 100px 0 80px;
  overflow: hidden;
}

/* Фоновая картинка */
.hero::before {
  content: '';
  position: absolute;
  inset: 0; /* top:0; right:0; bottom:0; left:0; */
  background: url('/img/main.jpg') center/cover no-repeat;
  z-index: 0;
}

/* Затемняющий градиент поверх картинки */
.hero::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, 
    rgba(26, 26, 26, 0.88) 0%,    /* почти чёрный */
    rgba(44, 44, 44, 0.78) 50%,   /* тёмно-серый */
    rgba(74, 74, 74, 0.65) 100%); /* средне-серый */
  z-index: 1;
}


  .hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 60px;
    align-items: center;
  }
  .hero__title {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 20px;
  }
  .hero__title span {
     color: #BDBDBD;
  }
  .hero__subtitle {
    font-size: 1.15rem;
    opacity: 0.9;
    margin-bottom: 32px;
    max-width: 520px;
  }
  .hero__actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .hero .btn-primary {
   background: #fff;
  color: var(--color-primary-dark);
  transition: background 0.2s, color 0.2s, transform 0.2s;
  }
  .hero .btn-primary:hover {
    background: #FFF3E0;   /* лёгкий персиково-оранжевый */
  color: #D35400;        /* акцентный оранжевый */
  transform: translateY(-2px);
  }
  .hero .btn-outline {
   border-color: rgba(255, 255, 255, 0.5);
  color: #fff;
  transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }
  .hero .btn-outline:hover {
    background: rgba(211, 84, 0, 0.15);  /* полупрозрачный оранжевый */
  border-color: #D35400;
  transform: translateY(-2px);
  }
  .hero__stats {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .hero__stat {
    background: rgba(255,255,255,0.12);
    backdrop-filter: blur(8px);
    border-radius: var(--radius);
    padding: 20px 28px;
    text-align: center;
    min-width: 180px;
  }
  .hero__stat-value {
    font-size: 2.2rem;
    font-weight: 800;
    display: block;
  }
  .hero__stat-value small {
    font-size: 0.9rem;
    font-weight: 600;
    margin-left: 4px;
  }
  .hero__stat-label {
    font-size: 0.85rem;
    opacity: 0.8;
  }

   @media (max-width: 768px) {
  .hero {
    padding: 60px 0 50px;
  }

  .hero__inner {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .hero__stats {
    flex-direction: row;
    flex-wrap: wrap;   /* страховка: если не влезут — перенос, а не overflow */
    width: 100%;
  }

  .hero__stat {
    flex: 1 1 140px;   /* растёт и сжимается, базовая ширина 140px */
    min-width: 0;      /* ГЛАВНОЕ: снимаем запрет на сжатие */
    padding: 16px 12px;
  }

  .hero__stat-value {
    font-size: 1.7rem;
  }

  .hero__stat-label {
    font-size: 0.75rem;
  }
}

/* Очень узкие экраны — складываем в колонку */
@media (max-width: 483px) {
  .hero__stats {
    flex-direction: column;
  }

  .hero__stat {
    flex: none;
    padding: 16px 20px;
  }

  .hero__stat-value {
    font-size: 1.8rem;
  }

  .hero__stat-label {
    font-size: 0.8rem;
  }

    .hero__actions {
    flex-direction: column;
    width: 100%;
  }

  .hero__actions .btn {
    width: 100%;
    justify-content: center;
  }
}
</style>