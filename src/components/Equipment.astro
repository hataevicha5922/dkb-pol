---
const equipment = [
  {
    title: 'Растворонасосы Putzmeister',
    text: 'Немецкое оборудование для механизированной подачи смеси. Обеспечивает равномерность и скорость укладки.',
    icon: '🔧',
  },
  {
    title: 'Фиброволокно и пластификаторы',
    text: 'Используем только сертифицированные добавки для повышения прочности и эластичности стяжки.',
    icon: '🧪',
  },
  {
    title: 'Профессиональный инструмент',
    text: 'Лазерные уровни, затирочные машины, виброрейки — всё для идеальной поверхности.',
    icon: '📏',
  },
];
---

<section class="equipment" id="equipment">
  <div class="container">
    <h2 class="section-title">Наше оборудование</h2>
    <p class="section-subtitle">
      Работаем на профессиональной технике для гарантированного результата
    </p>

    <div class="equipment__grid">
      {equipment.map(e => (
        <article class="equipment__card">
          <span class="equipment__icon">{e.icon}</span>
          <h3 class="equipment__title">{e.title}</h3>
          <p class="equipment__text">{e.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .equipment {
    padding: var(--section-padding);
  }
  .equipment__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }
  .equipment__card {
    background: linear-gradient(135deg, #F5F5F5, #fff);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 32px 28px;
    text-align: center;
  }
  .equipment__icon {
    font-size: 3rem;
    display: block;
    margin-bottom: 16px;
  }
  .equipment__title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-bottom: 10px;
  }
  .equipment__text {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }
</style>