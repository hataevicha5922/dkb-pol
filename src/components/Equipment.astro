---
const equipment = [
  {
    title: 'Растворонасосы Putzmeister',
    text: 'Немецкое оборудование для механизированной подачи смеси. Обеспечивает равномерность и скорость укладки.',
    image: 'img/putzmeister.jpg',
  },
  {
    title: 'Фиброволокно и пластификаторы',
    text: 'Используем только сертифицированные добавки для повышения прочности и эластичности стяжки.',
    image: 'img/fibro.jpg',
  },
  {
    title: 'Профессиональный инструмент',
     text: 'Лазерные уровни, затирочные машины, виброрейки — всё для идеальной поверхности.',
    image: 'img/equipment.jpg',
  },
];
---

<section class="equipment" id="equipment">
  <div class="container">
    <h2 class="section-title">Наше оборудование</h2>
    <p class="section-subtitle">
      Работаем на профессиональной технике для гарантированного результата
    </p>

    <div class="equipment__grid">
      {equipment.map(e => (
        <article class="equipment__card">
          <div class="equipment__image">
            <img src={e.image} alt={e.title} loading="lazy" />
          </div>
          <div class="equipment__content">
            <h3 class="equipment__title">{e.title}</h3>
            <p class="equipment__text">{e.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .equipment {
    padding: var(--section-padding, 80px 0);
     background: var(--color-bg-alt);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .section-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: #1a1a1a;
    text-align: center;
    margin: 0 0 16px;
  }

  .section-subtitle {
  font-size: 1.1rem;
  color: #666;
  text-align: center;
  margin: 0 auto 48px; /* ← добавлено auto для горизонтального центрирования */
  max-width: 600px;    /* ← ограничиваем ширину */
  line-height: 1.6;
}
  .equipment__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .equipment__card {
    background: #fff;
    border-radius: var(--radius, 12px);
    overflow: hidden;
    box-shadow: var(--shadow, 0 4px 16px rgba(0, 0, 0, 0.08));
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .equipment__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .equipment__image {
    height: 200px;
    overflow: hidden;
    /* background: #f5f5f5; */
     background: #fff; /* ← белый фон вместо серого */
    display: flex;
    align-items: center;
    justify-content: center;
  }

 .equipment__image img {
  width: 100%;
  height: 100%;
 object-fit: cover;          /* ← заполняет весь блок */
  object-position: center;    /* ← техника по центру, обрезка симметрична */
  transition: transform 0.4s ease;
}

.equipment__card:hover .equipment__image img {
  transform: scale(1.05);
}

  .equipment__content {
    padding: 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .equipment__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 12px;
  }

  .equipment__text {
    font-size: 0.95rem;
    color: #666;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 768px) {
    .equipment {
      padding: 60px 0;
    }

    .section-title {
      font-size: 2rem;
    }

    .equipment__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .equipment__image {
      height: 180px;
    }
  }
</style>