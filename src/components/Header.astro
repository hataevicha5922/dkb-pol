<script>
  const burgerBtn = document.getElementById('burgerBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  
  burgerBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('active');
  });
  
  // Закрываем меню при клике на ссылку
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.remove('active');
    });
  });

  // Определяем активный пункт по якорю в URL
  const currentHash = window.location.hash || '#hero';
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.header__nav a');

  navLinks.forEach(link => {
    if (link.getAttribute('href') === currentHash) {
      link.classList.add('active');
    }
  });

  // Обновляем активный пункт при клике
  navLinks.forEach(link => {
    link.addEventListener('click', (event: MouseEvent) => {
      navLinks.forEach(l => l.classList.remove('active'));
      // event.currentTarget гарантированно имеет тип HTMLAnchorElement
      (event.currentTarget as HTMLAnchorElement).classList.add('active');
    });
  });


   // Обновляем при скролле
  const sections = document.querySelectorAll<HTMLElement>('section[id]');

  window.addEventListener('scroll', () => {
    let current = '';
    const scrollY = window.scrollY;

    sections.forEach(section => {
      const sectionTop = section.offsetTop;
      if (scrollY >= sectionTop - 100) {
        const id = section.getAttribute('id');
        if (id) current = id; // null-check
      }
    });

    navLinks.forEach(link => {
      link.classList.remove('active');
      const href = link.getAttribute('href');
      if (href === `#${current}`) {
        link.classList.add('active');
      }
    });
  });

</script>

