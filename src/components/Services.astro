---
const services = [
  {
    title: 'Полусухая стяжка пола',
    description: 'Смесь бетона с фиброволокнами и пластификаторами. Идеально ровная поверхность за 1 день.',
    price: 'от 16 BYN/м²',
    features: ['Толщина от 60 мм', 'До 200 м² за смену', 'Механизированная укладка'],
    image: 'img/two.jpg',
  },
  {
    title: 'Стяжка с тёплым полом',
    description: 'Профессиональная укладка стяжки поверх системы тёплого пола с соблюдением всех технологий.',
    price: 'от 20 BYN/м²',
    features: ['Работа с любой системой', 'Контроль толщины', 'Гарантия на стяжку'],
    image: 'img/one.jpg',
  },
  {
    title: 'Шлифовка и ремонт стяжек',
    description: 'Восстановление и выравнивание существующих стяжек, устранение дефектов.',
    price: 'от 10 BYN/м²',
    features: ['Устранение трещин', 'Выравнивание перепадов', 'Подготовка под покрытие'],
    image: 'img/two.jpg',
  },
];
---

<section class="services" id="services">
  <div class="container">
    <h2 class="section-title">Наши услуги</h2>
    <p class="section-subtitle">
      Выполняем работы по стяжке пола в Гомеле и Гомельской области
    </p>

    <div class="services__grid">
      {services.map(s => (
        <article class="services__card">
          <div class="services__image">
            <img src={s.image} alt={s.title} loading="lazy" width="400" height="250" />
          </div>
          <div class="services__body">
            <h3 class="services__title">{s.title}</h3>
            <p class="services__desc">{s.description}</p>
            <ul class="services__features">
              {s.features.map(f => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--color-primary)">
                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                  </svg>
                  {f}
                </li>
              ))}
            </ul>
            <div class="services__footer">
              <span class="services__price">{s.price}</span>
              <a href="#contact" class="btn btn-primary services__btn">Заказать</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    padding: var(--section-padding);
  }
  .services__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 28px;
  }
  .services__card {
    background: #fff;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.3s ease;
  }
  .services__card:hover {
    transform: translateY(-4px);
  }
  .services__image {
    height: 220px;
    overflow: hidden;
    background: var(--color-bg-alt);
  }
  .services__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .services__body {
    padding: 24px;
  }
  .services__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-bottom: 10px;
  }
  .services__desc {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    margin-bottom: 16px;
    line-height: 1.5;
  }
  .services__features {
    margin-bottom: 20px;
  }
  .services__features li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    padding: 4px 0;
    color: var(--color-text);
  }
  .services__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--color-border);
    padding-top: 16px;
  }
  .services__price {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--color-primary);
  }
  .services__btn {
    padding: 10px 20px;
    font-size: 0.85rem;
  }
</style>